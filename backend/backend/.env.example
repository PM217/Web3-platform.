# Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# MONGODB CONFIGURATION
# ===========================================

# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/launchpad
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/launchpad
MONGODB_URI=mongodb://localhost:27017/launchpad

# MongoDB credentials (if using Atlas or auth)
DB_USERNAME=
DB_PASSWORD=

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server port (default: 5050)
PORT=5050

# JWT secret for authentication (generate a secure random string)
JWTSECRET=your-secure-jwt-secret-here

# ===========================================
# NOTES
# ===========================================

# 1. MongoDB connection is currently DISABLED in app.js
#    Uncomment the mongoose connection code to enable
# 2. The backend currently has NFT marketplace models that may not be needed
# 3. Consider if you need the backend at all - the launchpad works without it
# 4. If enabling, create launchpad-specific models for:
#    - IDO tracking
#    - User analytics
#    - Investment history

# ===========================================
# TO ENABLE MONGODB
# ===========================================

# 1. Install and run MongoDB locally, or create Atlas cluster
# 2. Uncomment mongoose.connect() in app.js
# 3. Create models specific to launchpad functionality
# 4. Remove or repurpose NFT marketplace code
