# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Storage contract address (BSC mainnet)
# This contract manages domain-based settings
REACT_APP_STORAGE_CONTRACT=0xa7472f384339D37EfE505a1A71619212495A973A

# ===========================================
# OPTIONAL - FOR DEVELOPMENT
# ===========================================

# Override the default storage contract for local testing
# REACT_APP_STORAGE_CONTRACT_LOCAL=0x...

# ===========================================
# NOTES
# ===========================================

# 1. The Storage contract is deployed on BSC (chain ID 56)
# 2. For local development, you may need to deploy your own Storage contract
# 3. The contract source code should be in contracts/Storage.sol (currently missing)
